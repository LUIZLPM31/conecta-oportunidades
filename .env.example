# ============================================================
#  Conecta Oportunidades — Variáveis de ambiente
#  Copie para .env e preencha com valores reais
# ============================================================

# --- Banco de Dados (MySQL — Aiven) ---
DB_HOST=seu-servico.aivencloud.com
DB_PORT=3306
DB_NAME=conecta_db
DB_USER=avnadmin
DB_PASSWORD=sua-senha-segura-aqui

# --- JWT (gere com: openssl rand -base64 48) ---
JWT_SECRET=cole-aqui-uma-chave-aleatoria-de-256-bits

# --- CORS (opcional, separado por vírgula) ---
CORS_ALLOWED_ORIGINS=https://conecta-oportunidades.vercel.app,http://localhost:5173
